# Copy to .env.compose.linux, chmod 600, never commit real values.
COMPOSE_PROJECT_NAME=sngsc-hauqe-linux
SNGSC_IMAGE=sngsc-hauqe:linux
SNGSC_HTTP_PORT=8002
HAUQE_DB_ADMIN_PASSWORD=REPLACE_DISTINCT_ADMIN_PASSWORD
HAUQE_DB_APP_PASSWORD=REPLACE_APP_DATABASE_PASSWORD
# Keep false during all rehearsals. Enable only after approved final cutover.
HAUQE_ENABLE_SMTP=false
