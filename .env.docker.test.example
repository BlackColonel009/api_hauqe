# Copy to .env.docker.test, never commit the real values.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql+psycopg://hauqe_test:REPLACE_ENCODED_TEST_PASSWORD@hauqe-postgres-test:5432/hauqe_certif_test
# Preserve the source keys privately for compatibility with encrypted MFA data.
SECRET_KEY=REPLACE_WITH_SOURCE_KEY
MFA_FERNET_KEY=REPLACE_WITH_SOURCE_KEY_IF_SET
ENVIRONMENT=docker-test
DEBUG=false
BACKGROUND_SERVICES_ENABLED=false
HAUQE_SMTP_ENABLED=false
HAUQE_SMTP_HOST=
HAUQE_SMTP_FROM=
LIEN_VERS_SNGSC=http://localhost:8001
# Password-reset URL will be set after checking the application's expected route.
