# Remplacer DOMAINE_SNGSC par le domaine définitif avant installation.
# Ce fichier publie l'application à la racine du domaine :
# https://DOMAINE_SNGSC/ et https://DOMAINE_SNGSC/api/v1/...

server {
    listen 80;
    listen [::]:80;
    server_name DOMAINE_SNGSC;

    client_max_body_size 25m;

    # L’API de documentation n’est pas publique par défaut.
    location ~ ^/(docs|redoc|openapi.json)$ {
        return 404;
    }

    # Les documents téléversés et les archives ne sont jamais servis par Nginx.
    location ~ ^/(uploads|backups|logs)/ {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8014;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}

# Après validation DNS et installation Certbot, compléter ce virtual host
# avec les directives TLS générées par Certbot et la redirection HTTP → HTTPS.
