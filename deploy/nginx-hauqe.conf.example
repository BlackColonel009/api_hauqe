# Adapt server_name, certificate paths and upstream port with HAUQE IT.
# Install only after local HTTP test and certificate provisioning.
server {
    listen 80;
    server_name sngsc.example.org;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name sngsc.example.org;
    ssl_certificate /etc/letsencrypt/live/sngsc.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sngsc.example.org/privkey.pem;
    client_max_body_size 25m;
    location / {
        proxy_pass http://127.0.0.1:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }
}
