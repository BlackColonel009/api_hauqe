# ============================================================
# HAUQE CERTIF
# ============================================================

APP_NAME=HAUQE Certif
ENVIRONMENT=development
DEBUG=true

# PostgreSQL + Psycopg 3 async
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/hauqe_certif

# Sécurité
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_FERNET_KEY=CHANGE_ME_WITH_A_VALID_FERNET_KEY
PASSWORD_RESET_URL_TEMPLATE=https://VOTRE_DOMAINE/#/mot-de-passe-oublie?token={token}

# Fuseau horaire
TIMEZONE=Africa/Lome

# Courriels SMTP
HAUQE_SMTP_HOST=smtp.gmail.com
HAUQE_SMTP_PORT=587
HAUQE_SMTP_USER=CHANGE_ME
HAUQE_SMTP_PASSWORD=CHANGE_ME_WITH_AN_APP_PASSWORD
HAUQE_SMTP_FROM=CHANGE_ME
HAUQE_SMTP_USE_TLS=true

# Sessions et protection contre les tentatives abusives
AUTH_SESSION_MINUTES=480
AUTH_IDLE_TIMEOUT_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_FAILURE_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15
