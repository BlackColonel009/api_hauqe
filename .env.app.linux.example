# Copy to .env.app.linux, chmod 600. Plain DB password must match compose secret.
# In DATABASE_URL only, percent-encode password special characters.
DATABASE_URL=postgresql+psycopg://hauqe_app:REPLACE_ENCODED_APP_DATABASE_PASSWORD@db:5432/hauqe_certif
SECRET_KEY=REPLACE_WITH_SOURCE_SECRET_KEY
MFA_FERNET_KEY=REPLACE_WITH_SOURCE_FERNET_KEY
BACKGROUND_SERVICES_ENABLED=false
HAUQE_SMTP_ENABLED=false
HAUQE_SMTP_HOST=
HAUQE_SMTP_PORT=587
HAUQE_SMTP_USER=
HAUQE_SMTP_PASSWORD=
HAUQE_SMTP_FROM=
HAUQE_SMTP_USE_TLS=true
LIEN_VERS_SNGSC=https://REPLACE_PUBLIC_HOST
# Set PASSWORD_RESET_URL_TEMPLATE to the verified public route before go-live.
